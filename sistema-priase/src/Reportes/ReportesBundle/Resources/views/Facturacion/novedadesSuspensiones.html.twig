{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />    
{% endblock %}
{% block titulo %}Reporte de novedades de suspensiones o reconexiones ejecutadas  - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="facturacionController">
        <form name="reporte" novalidate >
            <div id="divPanelContenedor">
                <fieldset>  
                    <legend>Generacion de informe de novedades de suspensiono reconexion</legend>
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3> Parametros para la generacion de informacion</h3>
                            </div>
                            <div class="panel-body"> 
                                <div class="row">
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Fecha inicial</label>
                                        <input type="text" id="fechaInicial" name="fechaInicial" ng-model="info.fechaInicial" required="true" class="input-sm form-control datepicker"/>
                                        <p class="help-block" ng-if="reporte.fechaInicial.$error.required">
                                            La fecha inicial es requerida.
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Fecha final</label>
                                        <input type="text" id="fechaFinal" name="fechaFinal" ng-model="info.fechaFinal" required="true" class="form-control datepicker"/>
                                        <p class="help-block" ng-if="reporte.fechaFinal.$error.required">
                                            La fecha final es requerida.
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors>
                                        <label>Tipo de reporte</label>
                                        <select required="true" id="tipoReporte" name="tipoReporte" ng-model="info.tipoReporte" class="form-control input-sm">
                                            <option value="1">Novedades de suspension</option>
                                            <option value="2">Novedades de reconexion</option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoSuspension.$error.required">
                                            El tipo de reporte es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors ng-if="info.tipoReporte == 1">
                                        <label>Motivo de suspensi&oacute;n</label>
                                        <select multiple="true" required="true" id="motivo" name="motivo" ng-model="info.motivo" class="form-control">
                                            <option value="-1">Todos los motivos de suspensi&oacute;n</option>
                                            <option ng-repeat="item in motivosSuspension" ng-value="item.uni_id">
                                                {[{item.uni_nombre}]}
                                            </option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoSuspension.$error.required">
                                            El motivo de suspensi&oacute;n es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors ng-if="info.tipoReporte == 2">
                                        <label>Motivo de reconexi&oacute;n</label>
                                        <select multiple="true" required="true" id="motivo" name="motivo" ng-model="info.motivo" class="form-control">
                                            <option value="-1">Todos los motivos de reconexi&oacute;n</option>
                                            <option ng-repeat="item in motivosReconexion" ng-value="item.uni_id">
                                                {[{item.uni_nombre}]}
                                            </option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.motivo.$error.required">
                                            El motivo de reconexi&oacute;n es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors ng-if="info.tipoReporte == 1">
                                        <label>Tipo de suspensi&oacute;n</label>
                                        <select required="true" id="tipoSuspension" name="tipoSuspension" ng-model="info.tipoSuspension" class="form-control input-sm">
                                            <option value="-1">Todos los tipos de suspensi&oacute;n</option>
                                            <option ng-repeat="item in tiposSuspension" ng-value="item.uni_id">
                                                {[{item.uni_nombre}]}
                                            </option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoSuspension.$error.required">
                                            El tipo de suspensi&oacute;n es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors ng-if="info.tipoReporte == 1">
                                        <label>Novedad de suspensi&oacute;n</label>
                                        <select required="true" id="novedad" name="novedad" ng-model="info.novedad" class="form-control input-sm">
                                            <option value="-1">Todos las novedades de suspensi&oacute;n</option>
                                            <option ng-repeat="item in novedadesSuspension" ng-value="item.uni_id">
                                                {[{item.uni_nombre}]}
                                            </option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.novedad.$error.required">
                                            La novedad de suspensi&oacute;n es requerida
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors ng-if="info.tipoReporte == 2">
                                        <label>Novedad de reconexion</label>
                                        <select required="true" id="novedad" name="novedad" ng-model="info.novedad" class="form-control input-sm">
                                            <option value="-1">Todos las novedades de reconexion</option>
                                            <option ng-repeat="item in novedadesReconexion" ng-value="item.uni_id">
                                                {[{item.uni_nombre}]}
                                            </option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.novedad.$error.required">
                                            La novedad de reconexion es requerida
                                        </p>
                                    </div>
                                    <div class="form-group col-md-12" show-errors>
                                        <label>Tipo de uso</label>
                                        <select required="true" id="tipoUso" name="tipoUso" ng-model="info.tipoUso" class="form-control input-sm">
                                            <option value="-1">Todos los tipos de uso</option>
                                            <option ng-repeat="tipoUso in tiposUso" ng-value="tipoUso.tipo_uso_id">{[{tipoUso.tipo_uso_nombre}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoUso.$error.required">
                                            El tipo de uso es requerido
                                        </p>
                                    </div>                                    
                                </div>                                   
                            </div>                            
                            <div class="panel-footer">                                
                                <div class="col-md-4 col-md-offset-8">
                                    <button ng-click="download=true;generarReporte()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-gears fa-1x"></i> Generar Reporte
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>                
                </fieldset>
            </div>
        </form>        
    </div>
{% endblock %}

{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/moment-with-locales.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/facturacion/novedadesSuspension.control.angular.js')}}"></script>
{% endblock %}