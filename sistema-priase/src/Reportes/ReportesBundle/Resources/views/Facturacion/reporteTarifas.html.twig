{% extends "::base.html.twig" %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}

{% block titulo %} Facturación Tarifas  {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="TarifasControllerAngular">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Filtros de búsqueda</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                <div class="form-group col-md-6" show-errors>
                                <label>Mercados</label>
                                <select required="true" id="cbmMercados" name="mercados" ng-model="mercado" class="form-control">
                                    <option value="-1" >Todos los Mercados</option>
                                    <option ng-repeat="mercado in mercados" ng-value="mercado.idmercado">
                                        {[{mercado.nombre}]}
                                    </option>
                                </select>
                                <p class="help-block">
                                    Debe seleccionar un mercado.
                                </p>
                            </div>
                                <div class="form-group col-md-6" show-errors>
                                    <label>Periodo</label>
                                    <input type="text" ng-model="periodo" class="form-control" disabled="true"/>
                                </div>                                 
                            </div>    
                        </div>
                        <div class="panel-footer">    
                            <div class="col-md-9">
                                <div class="alert-box info">
                                    Toda la informacion sera generada en un archivo .xlsx
                                </div>  
                            </div>
                            <div class="col-md-3">
                                <button type="button" ng-click="generarReporte()" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-gears fa-lg"></i> Generar reporte regulados
                                </button>
                            </div>               
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>

{% endblock %}
{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular-modal-service.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/facturacion/reporteTarifas.angular.js')}}"></script>
{% endblock %}