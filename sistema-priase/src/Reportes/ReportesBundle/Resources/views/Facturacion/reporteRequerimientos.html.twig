{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte Requerimentos -{{empresa}} {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="RequerimientosController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Reporte Requerimientos</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                 
                            <div class="row">
                                 <div class="col-md-4 form-group" show-errors>
                                    <label for="fechaConsulta">Fecha Consulta (yyyy):</label>
                                    <select id="fechaConsulta" name="fechaConsulta" ng-model="info.fechaConsulta" ng-options="year for year in years" class="form-control">
                                        
                                    </select>
                                   
                                </div>
                                    
                            </div>    
                            </div>
                           
                                                             
                           
                        </div>
                        <div class="panel-footer">    
                            <div class="col-md-9">
                                <div class="alert-box info">
                                    este archivo se genera en formato .xlsx
                                </div>  
                            </div>
                            <div class="btn-group">
                                    <button type="button" class="btn btn-primary btn-sm pull-right" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-gears fa-lg"></i> Generar reporte <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        
                                        <li>
                                            <a ng-click="download=true;generarReporte2()">
                                                <i class="fa fa-file-excel-o fa-lg"></i> Domiciliario-Comercial
                                            </a>
                                        </li>
                                        
                                    </ul>
                                </div>              
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
            
            <fieldset>
                <legend>Reporte Rutas</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                 
                            <div class="row">
                                 <div class="col-md-4 form-group" show-errors>
                                    <label>Periodo</label>
                                    <select required="true" id="mes" name="mes" ng-model="info.mes" class="form-control">
                                        <option value="1">Enero</option>
                                        <option value="2">Febrero</option>
                                        <option value="3">Marzo</option>
                                        <option value="4">Abril</option>
                                        <option value="5">Mayo</option>
                                        <option value="6">Junio</option>
                                        <option value="7">Julio</option>
                                        <option value="8">Agosto</option>
                                        <option value="9">Septiembre</option>
                                        <option value="10">Octubre</option>
                                        <option value="11">Noviembre</option>
                                        <option value="12">Diciembre</option>
                                    </select>
                                    <p class="help-block" ng-if="reporte.mes.$error.required">
                                        El mes a consultar es requerido.
                                    </p>   
                                    </select>
                                </div>
                                <div class="form-group col-md-4" show-errors>
                                    <label>Año</label>
                                    <input type="number" ng-model="info.anno" id="anno" name="anno" class="form-control input-sm"/>
                                    <p class="help-block" ng-if="reporte.anno.$error.required">
                                        El año de consulta es requerido.
                                    </p>
                                </div>    
                            </div>    
                            </div>
                           
                                                             
                           
                        </div>
                        <div class="panel-footer">    
                            <div class="col-md-9">
                                <div class="alert-box info">
                                    este archivo se genera en formato .xlsx
                                </div>  
                            </div>
                            <div class="col-md-3">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporteRutas()">
                                        <i class="fa fa-file-excel-o fa-lg"></i> Generar Reporte
                                    </button>
                                </div>             
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/facturacion/general.requerimientos.angular.js')}}"></script>
{% endblock %}
