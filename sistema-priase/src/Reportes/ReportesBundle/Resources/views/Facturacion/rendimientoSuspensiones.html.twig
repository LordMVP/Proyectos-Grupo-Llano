{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />    
{% endblock %}
{% block titulo %}Reporte de rendimientos de suspensiones o reconexiones - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="facturacionController">
        <form name="reporte" novalidate >
            <div id="divPanelContenedor">
                <fieldset>  
                    <legend>Generacion de informe de novedades de suspensiono reconexion</legend>
                    
                    <div class="row">
                        <div class="col-md-12 col-lg-3">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3> Parametros para la generacion de la información resumen</h3>
                                </div>
                                <div class="panel-body"> 
                                    <div class="row">
                                        <div class="form-group col-md-12" show-errors>
                                            <label>Fecha Consulta</label>
                                            <input type="text" id="fechaConsulta" name="fechaConsulta" ng-model="info.fechaConsulta" required="true" class="input-sm form-control datepicker"/>
                                            <p class="help-block" ng-if="reporte.fechaConsulta.$error.required">
                                                La fecha de consulta es requerida.
                                            </p>
                                        </div>                                  
                                    </div>                                   
                                </div>                            
                                <div class="panel-footer">                                
                                    <div class="col-md-4 col-md-offset-8">
                                        <button ng-click="download=true;verResumenDiario()" class="btn btn-primary btn-sm pull-right">
                                            <i class="fa fa-gears fa-1x"></i> Ver Resumen
                                        </button>
                                    </div>               
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div> 
                    
                        <div class="col-md-12 col-lg-9">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3> Resumen de Actividades</h3>
                                </div>
                                <div class="panel-body"> 
                                    <table id="resultados" class="table table-responsive table-condensed table-hover">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Cuadrilla</th>
                                                <th>Asignadas</th>                                            
                                                <th>Ejecutadas</th>                                            
                                                <th>Pendientes</th>
                                                <th>Fotos</th>
                                            </tr>
                                        </thead>
                                        
                                        <tbody>
                                            <tr ng-show="!resumen || resumen.length==0">
                                                <td colspan="4">No hay resultados para mostrar</td>
                                            </tr>
                                            <tr ng-repeat="item in resumen.slice(((currentPage1-1)*itemsPerPage1), ((currentPage1)*itemsPerPage1))" id="tr_ure_{[{item.ure}]}">
                                                <td>
                                                    <input type="radio" name="venta" id="ck_ure_{[{item.ure}]}" ng-click="seleccionarFila(item)" />
                                                </td>
                                                <td>{[{item.nombre}]}</td>
                                                <td>{[{item.total}]}</td>
                                                <td>{[{item.ejecutadas}]}</td>
                                                <td>{[{item.pendientes}]}</td>
                                                <td>{[{item.fotos}]} de {[{item.total}]}</td>
                                            </tr>
                                        </tbody>                                    
                                    </table>     
                                    <ul><uib-pagination total-items="totalItems1" ng-model="currentPage1" ng-change="pageChanged()" class="pagination-sm" items-per-page="itemsPerPage1"/></ul>
                                </div>                            
                                <div class="panel-footer">                                
                                    <div class="col-md-4 col-md-offset-8">
                                        <button ng-click="download=true;generarReporteResumen()" class="btn btn-primary btn-sm pull-right">
                                            <i class="fa fa-gears fa-1x"></i> Generar Reporte
                                        </button>
                                    </div>               
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div> 
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 col-lg-12">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3> Detalle de Actividades</h3>
                                </div>
                                <div class="panel-body"> 
                                    <table id="detalle" class="table table-responsive table-condensed table-hover">
                                        <thead>
                                            <tr>
                                                <th>Inicio</th>
                                                <th>Fin</th>                                            
                                                <th>Cod Anterior</th> 
                                                <th>Ruta-Consecutivo</th>  
                                                <th># Medidor</th> 
                                                <th>Tercero</th> 
                                                <th>Novedad</th>
                                                <th>Fotos</th>
                                                <th>Estado</th>  
                                            </tr>
                                        </thead>
                                        
                                        <tbody>
                                            <tr ng-show="totalItems==0">
                                                <td colspan="4">No hay resultados para mostrar</td>
                                            </tr>
                                            <tr ng-repeat="item in detalle.slice(((currentPage2-1)*itemsPerPage2), ((currentPage2)*itemsPerPage2))" id="tr_det_{[{item.suscripcion}]}">
                                                <td>{[{item.fec_ini}]}</td>
                                                <td>{[{item.fec_fin}]}</td>
                                                <td>{[{item.cod_anterior}]}</td>
                                                <td>{[{item.rutacodigo}]}-{[{item.rutasecuencia}]}</td>
                                                <td>{[{item.medidor}]}</td>
                                                <td>{[{item.tercero}]}</td>
                                                <td>{[{item.novedad}]}</td>
                                                <td>{[{item.fotos}]}</td>
                                                <td>{[{item.realizada}]}</td>
                                            </tr>
                                        </tbody> 
                                    </table>     
                                    <ul><uib-pagination total-items="totalItems2" ng-model="currentPage2" ng-change="pageChanged()" class="pagination-sm" items-per-page="itemsPerPage2"/></ul>
                                </div>                            
                                <div class="panel-footer">                                
                                    <div class="col-md-4 col-md-offset-8">
                                        <button ng-click="download=true;generarReporteDetalle()" class="btn btn-primary btn-sm pull-right">
                                            <i class="fa fa-gears fa-1x"></i> Generar Reporte
                                        </button>
                                    </div>               
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div> 
                    </div>
                </fieldset>
            </div>
        </form>        
    </div>
{% endblock %}

{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/moment-with-locales.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ui-bootstrap-tpls-1.3.2.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/facturacion/rendimientoSuspension.control.angular.js')}}"></script>
{% endblock %}