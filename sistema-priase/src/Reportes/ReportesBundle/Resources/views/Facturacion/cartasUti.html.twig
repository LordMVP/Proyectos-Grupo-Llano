{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />    
{% endblock %}
{% block titulo %}Reporte notificaciones UTI - Generacion de cartas  - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="facturacionController">
        <form name="reporte" novalidate >
            <div id="divPanelContenedor">
                <fieldset>  
                    <legend>Generacion de cartas relacionadas a la UTI</legend>
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3> Parametros para la generacion de informacion</h3>
                            </div>
                            <div class="panel-body"> 
                                <div class="row">
                                    <div class="form-group col-md-12" show-errors>
                                        <label>Tipo de carta</label>
                                        <select required="true" id="tipoCarta" name="tipoCarta" ng-model="info.tipoCarta" class="form-control input-sm">
                                            <option value="1">Primera Carta (5 Meses)</option>
                                            <option value="2">Segunda Carta (2 Meses)</option>
                                            <option value="3">Tercera Carta (Mes actual)</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoCarta.$error.required">
                                            El tipo de carta es requerido.
                                        </p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Mes</label>                                        
                                        <select required="true" id="mes" name="mes" ng-model="info.mes" class="form-control">
                                            <option value="01">Enero</option>
                                            <option value="02">Febrero</option>
                                            <option value="03">Marzo</option>
                                            <option value="04">Abril</option>
                                            <option value="05">Mayo</option>
                                            <option value="06">Junio</option>
                                            <option value="07">Julio</option>
                                            <option value="08">Agosto</option>
                                            <option value="09">Septiembre</option>
                                            <option value="10">Octubre</option>
                                            <option value="11">Noviembre</option>
                                            <option value="12">Diciembre</option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.mes.$error.required">
                                            El mes a consultar es requerido.
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Año de consulta</label>
                                        <input type="number" ng-model="info.anno" id="anno" name="anno" class="form-control input-sm"/>
                                        <p class="help-block" ng-if="reporte.anno.$error.required">
                                            El año de consulta es requerido.
                                        </p>
                                    </div>
                                    <!--<div class="form-group col-md-6" show-errors>
                                        <label>Fecha de inicial</label>
                                        <input type="text" id="fechaInicial" name="fechaInicial" ng-model="info.fechaInicial" required="true" class="input-sm form-control datepicker"/>
                                        <p class="help-block" ng-if="reporte.fechaInicial.$error.required">
                                            La fecha inicial es requerida.
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Fecha de final</label>
                                        <input type="text" id="fechaCorte" name="fechaFinal" ng-model="info.fechaFinal" required="true" class="input-sm form-control datepicker"/>
                                        <p class="help-block" ng-if="reporte.fechaFinal.$error.required">
                                            La fecha final es requerida.
                                        </p>
                                    </div>-->
                                </div>
                                <div class="row">
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Proyecto</label>
                                        <select required="true" id="proyecto" name="proyecto" ng-model="info.proyecto" class="form-control" multiple="true">
                                            <option value="-1">Todos los proyectos</option>
                                            {%for item in municipios%}
                                                <option value="{{item.idmunicipio}}">{{item.municipio}}</option>
                                            {%endfor%}
                                        </select>
                                        <p class="help-block" ng-if="reporte.proyecto.$error.required">
                                            El proyecto es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Tipo de uso</label>
                                        <select required="true" id="tipoUso" name="tipoUso" ng-model="info.tipoUso" class="form-control input-sm">
                                            <option value="-1">Todos los tipos de uso</option>
                                            <option ng-repeat="tipoUso in tiposUso" ng-value="tipoUso.tipo_uso_id">{[{tipoUso.tipo_uso_nombre}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoUso.$error.required">
                                            El tipo de uso es requerido
                                        </p>
                                    </div>
                                </div>
                                <div class="row">   
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Ciclo</label>
                                        <select required="true" id="ciclo" name="ciclo" ng-model="info.ciclo" ng-change="cambiarCiclo()" class="form-control input-sm">
                                            <option value="-1">Todos los ciclos</option>
                                            {%for item in ciclos%}
                                                <option value="{{item.idciclo}}">{{item.ciclo}}</option>
                                            {%endfor%}
                                        </select>
                                        <p class="help-block" ng-if="reporte.ciclo.$error.required">
                                            El ciclo es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Ruta</label>
                                        <select required="true" id="ruta" name="ruta" ng-model="info.ruta" class="form-control input-sm">
                                            <option value="-1">Todas las rutas</option>
                                            <option ng-repeat="ruta in rutas" ng-value="ruta.idruta">{[{ruta.nombre}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.ruta.$error.required">
                                            La ruta es requerida
                                        </p>
                                    </div>  
                                </div>                                   
                            </div>                            
                            <div class="panel-footer">                                
                                <div class="col-md-4">
                                    <button ng-click="download=true;generarReporte(1)" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-gears fa-1x"></i> Generar Reporte
                                    </button>
                                </div>
                                
                                <div class="col-md-4">
                                    <button ng-click="download=true;generarReporte(2)" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-gears fa-1x"></i> Generar Listado
                                    </button>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>                
                </fieldset>
            </div>
        </form>        
    </div>
{% endblock %}

{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/moment-with-locales.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/facturacion/cartasUti.control.angular.js')}}"></script>
{% endblock %}