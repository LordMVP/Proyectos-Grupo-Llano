{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte CREG -{{empresa}} {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="GeneralCregController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Reporte CREG</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                 
                                <div class="col-md-4 form-group" show-errors>
                                    <label for="fechaConsulta1">Fecha Periodo Consulta (yyyy-mm-dd):</label>
                                    <input class="form-control datepicker input-sm" ng-model="info.fechaConsulta1" id="fechaConsulta1" name="fechaConsulta1" />
                                   
                                </div> 
                            </div>                           
                        </div>
                        <div class="panel-footer">    
                            <div class="col-md-9">
                                <div class="alert-box info">
                                    Toda la informacion sera generada en un archivo .xlsx
                                </div>  
                            </div>                            
                            <div class="btn-group">
                                    <button type="button" class="btn btn-primary btn-sm pull-right" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-gears fa-lg"></i> Generar reporte  <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu">                                                                              
                                        <li>
                                            <a ng-click="download=true;generarReporte2()">
                                                <i class="fa fa-file-excel-o fa-lg"></i>Generar Reporte Creg 
                                            </a>
                                        </li>
                                        
                                        <li>
                                            <a ng-click="download=true;generarReporte4()">
                                                <i class="fa fa-file-pdf-o fa-lg"></i>Creg Comprobacion 
                                            </a>
                                        </li>
                                        
                                    </ul>
                                </div>              
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/facturacion/general.creg.angular.js')}}"></script>
{% endblock %}
