{# empty Twig template #}
{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/modalSimple.css')}}" />
{% endblock %}
{% block titulo %}Parametrizacion Reportes - {{empresa}} {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="ParametrizacionReportesControllerAngular">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Nuevo Registro Reporte</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                <div class="form-group col-md-12">
                                    <label>Reporte Parametros (Editar)</label>
                                    <select id="editar" name="editar" ng-model="info.editar"  ng-options="editar.nombrecompleto for editar in reporteUnidades" ng-selected="info.editar.ru_empresa == info.current.empresa"  class="form-control" ng-change="cargarEditar()" ng-disabled="info.current.nombre.length>0 && info.editar===null ? true : false"> 
                                    </select>                                    
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Nuevo Reporte Parametros</label>
                                    <input type="text" id="nombre" name="nombre" ng-model="info.current.nombre" class="form-control" ng-disabled="info.editarestado">   
                                    <p class="help-block">
                                        Debe seleccionar un mercado.
                                    </p>
                                </div>
                                <div class="form-group col-md-6" >
                                    <label>Empresa</label>
                                    <select id="empresa" name="empresa" ng-model="info.empresaTmp" ng-change="cargarCategoriaEmpresa()" ng-options="empresaTmp.nombre for empresaTmp in empresas" class="form-control" ng-disabled="info.estadoEmpresa">
                                    </select>                                 
                                </div>
                                <div class="form-group col-md-6" >
                                    <label>Logo</label>
                                    <input type="text" id="nombre" name="nombre" ng-model="info.current.logo" class="form-control" ng-disabled="info.editarestado">                                        
                                </div> 
                                <div class="form-group col-md-6" >
                                    <label>Tipo de Parametro</label>
                                    <select id="tipo" name="tipo" ng-model="info.parametro.TIPO" class="form-control" ng-change="cambioTipo()">
                                        <option value="UNIDAD" >UNIDAD</option>
                                        <option value="SENTENCIA" >SENTENCIA</option>
                                        <option value="CICLOS" >CICLOS</option>
                                        <option value="PROYECTOS" >PROYECTOS</option>
                                    </select>                                   
                                </div>                                
                                <div class="form-group col-md-6" >
                                    <label>Nombre</label>
                                    <input type="text" id="nombre" name="nombre" ng-model="info.parametro.NOMBRE" class="form-control">                                        
                                </div> 
                                <div class="form-group col-md-6" >
                                    <label>Descricpion</label>
                                    <input type="text" id="nombre" name="nombre" ng-model="info.parametro.DESCRIPCION" class="form-control">                                                                           
                                </div>                                
                                <div class="form-group col-md-6" ng-show="info.parametro.TIPO=='UNIDAD'">
                                    <label>Categoria</label>
                                    <select id="categoria" name="categoria" ng-change="cargarUnidadesCategoria()" ng-model="info.categoria" class="form-control">
                                        <option ng-repeat="categoria in categorias" ng-value="categoria.ideestructura">
                                            {[{categoria.nombre}]}
                                        </option>
                                    </select>                                   
                                </div>                                
                                <div class="form-group col-md-12" ng-show="info.parametro.TIPO=='UNIDAD' || info.parametro.TIPO=='CICLOS' || info.parametro.TIPO=='PROYECTOS'">
                                    <label style="font-weight:bold">Unidades</label>
                                    <div class="row">
                                          <label ng-repeat="uni in unidades" class="col-md-4">
                                            <input
                                              type="checkbox"
                                              name="selectedFruits[]"
                                              value="{[{fruitName.id}]}"
                                              ng-checked="seleccion.uni_ideregistro.indexOf(uni.uni_ideregistro) > -1"
                                              ng-click="toggleSelection(uni)"
                                            >{[{uni.uni_ideregistro}]} - {[{uni.uni_nombre1}]}
                                          </label>
                                    </div>     
                            </div>
                            <div class="form-group col-md-12 " ng-show="info.parametro.TIPO=='SENTENCIA'">
                                <label style="font-weight:bold">Sentencia</label>
                                <input type="text" ng-model="info.parametro.SENTENCIA" class="form-control">
                            </div>    
                             <div class="form-group col-md-12">
                                <button type="button" ng-click="agregarParametro()" class="btn btn-primary btn-sm" ng-disabled="info.parametro.TIPO==='SENTENCIA' && info.parametro.SENTENCIA.length>0 ? false : (info.parametro.TIPO==='UNIDAD' || info.parametro.TIPO==='CICLOS' || info.parametro.TIPO==='PROYECTOS') && info.seleccion.length>0 ? false :true ">
                                    <i class="fa fa-gears fa-lg"></i> Agregar Parametro
                                </button>
                            </div>     
                        </div>
                        <div class="row">
                            <div class="form-group col-md-12" >
                              <label>Parametros</label>
                              <table class="table table-stripe" >
                                <thead><tr>
                                <th>Nombre</th>
                                <th>Descripcion</th>
                                <th>Unidades</th>
                                <th>Sentencia</th>
                                <th> Eliminar </th>
                                </tr></thead>
                                <tbody>
                                <tr ng-repeat="param in info.current.parametros">
                                  <td> {[{ param.NOMBRE}]} </td>
                                  <td> {[{ param.DESCRIPCION}]} </td>
                                  <td> {[{ param.UNIDADES }]} </td>
                                  <td> {[{ param.SENTENCIA }]} </td>
                                  <td> <button class='btn btn-danger' ng-click="eliminarParametro($index)">Eliminar</button> </td>
                                </tr>
                                </tbody>
                             </table> 
                            </div>  
                        </div>                      
                        <div class="panel-footer">                            
                            <div class="col-md-4">
                                <button type="button" ng-click="guardar()" class="btn btn-primary btn-sm" ng-disabled="info.editar.ru_id==null  && info.current.nombre.length>0 && info.empresaTmp!=null ? false : true">
                                    <i class="fa fa-gears fa-lg"></i> Nuevo Reporte Unidades
                                </button>
                            </div>
                            <div class="col-md-4">
                                <button type="button" ng-click="editar()" class="btn btn-primary btn-sm " ng-disabled="info.editar.ru_id>0 && info.current.nombre.length>0 ? false : true">
                                    <i class="fa fa-gears fa-lg"></i> Editar Reporte Unidades
                                </button>
                            </div>
                            <div class="col-md-4">
                                <button type="button" ng-click="valoresReporte()" class="btn btn-primary btn-sm" ng-disabled="info.editar.ru_id>0 && info.current.nombre.length>0 ? false : true">
                                    <i class="fa fa-gears fa-lg"></i> Caracteristicas Reporte
                                </button>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>

         <script type="text/ng-template" id="myModalContent.html" style="overflow-y: scroll">
                               <div class="modal-header">
                                  <p style="font-weight: bold">Resultado Consulta</p>
                               </div>
                               <div class="modal-body" style="max-height:600px; overflow-y:auto;">
                               <h4 style="font-weight: bold">Consulta</h4>
                               <div class="row">
                                    <p class="col-md-12" align="justify">{[{test.consulta}]}</p>
                               </div>        
                               <br></br>
                               <h4 style="font-weight: bold">Parametros</h4>
                               <div class="row">
                                    <ul id="parame">
                                             <li style=" float:left;  width: 200px;" class="col-md-12" ng-repeat="item in test.parametros">

                                                 <div class="caption">
                                                     <h3>{[{item.valor}]}</h3>
                                                 </div>
                                             </li>
                                     </ul>
                                </div>
                                <br></br>
                                <h4 style="font-weight: bold">Subreportes</h4>
                                <div class="row">                                                                     
                                    <ul id="sub">
                                             <li style=" float:left;  width: 200px;" class="col-md-12" ng-repeat="item in test.subreportes">

                                                 <div class="caption">
                                                     <h3>{[{item.valor}]}</h3>
                                                 </div>
                                             </li>
                                     </ul>
                               </div>
                               <br></br>
                               <button class="btn btn-primary" ng-click="cancel()">Aceptar</button>
                               </div>

 
        </script>

    </div>

{% endblock %}
{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular-modal-service.js')}}"></script>
     <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/checklist-model.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/admin/ui-bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/admin/parametrizacionReportes.angular.js')}}"></script>
{% endblock %}