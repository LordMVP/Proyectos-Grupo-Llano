{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte de recuperacion y efectividad de cartera - {{empresa}}  {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="CarteraController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Parametros del reporte</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3> Ingrese los datos necesarios para la generacion del formato de arqueo de caja.</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="form-group col-md-4" show-errors>
                                        <label>Ciclo</label>
                                        <select required="true" id="ciclo" ng-change="actualizarPeriodos()" name="ciclo" ng-model="info.ciclo" class="form-control">
                                            <option ng-repeat="ciclo in ciclos" ng-value="ciclo.idciclo">{[{ciclo.ciclo}]}</option>
                                        </select>
                                        <p class="help-block" ng-if="reporte.ciclo.$error.required">
                                            El ciclo es requerido
                                        </p>
                                    </div>
                                    
                               <div class="form-group col-md-3" show-errors>
                                        <label>Municipio</label>
                                        <select type="text" name="municipio" id="municipio" ng-model="info.municipio" required="true" class="form-control input-sm">
                                            
                                            <option ng-repeat="item in municipios" ng-value="item.idmunicipio">{[{item.municipio}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.municipio.$error.required">
                                            El municipio es requerido
                                        </p>
                                </div>
                            </div>    

                        </div>
                        <div class="panel-footer">    
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="alert-box info">
                                        Este reporte puede ser generado de dos formas, la primera en formato Excel, para efectos de liquidacion de honorarios de la gestora,
                                        
                                    </div>  
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-md-offset-2">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(1)">
                                        <i class="fa fa-file-excel-o fa-lg"></i> Reporte Recuperacion
                                    </button>
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(2)">
                                        <i class="fa fa-file-pdf-o fa-lg"></i> Reporte Efectividad
                                    </button>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/recuperacionCartera.control.angular.js')}}"></script>
{% endblock %}
