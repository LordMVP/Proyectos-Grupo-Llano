{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte Interes Mora Base y Liquidado - {{empresa}} {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="carteraController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Interes Mora Base y Liquidado </legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                <div class="form-group col-md-6" show-errors>
                                   <label>Ciclo</label>
                                   <select required="true" id="ciclo" name="ciclo" ng-model="info.ciclo" ng-change="cambiarCiclo()" class="form-control input-sm">
                                       <option value="-1">Todos los ciclos</option>
                                       {%for item in ciclos%}
                                           <option value="{{item.idciclo}}">{{item.ciclo}}</option>
                                       {%endfor%}
                                   </select>
                                   <p class="help-block" ng-if="reporte.ciclo.$error.required">
                                       El ciclo es requerido
                                   </p>
                                </div>
                                <div class="col-md-6 form-group " show-errors>
                                    <label>Fecha de corte</label>
                                    <input class="form-control datepicker input-sm" ng-model="info.fechaCorte" id="fechaCorte" name="fechaCorte" required="true" />
                                    <p class="help-block" ng-if="reporte.fechaCorte.$error.required" >
                                        La fecha de corte es requerida
                                    </p>
                                </div>
                            </div>  
                        </div>
                        <div class="panel-footer">    
                            <div class="col-md-6">
                                <div class="alert-box info" id="result">
                                    Toda la informacion sera generada en un archivo .xls
                                </div>  
                            </div>
                            <div class="col-md-3">
                                <button type="button" ng-click="generarReporteBase()" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-gears fa-lg"></i> Reporte Base Intereses Mora
                                </button>
                            </div>  
                            <div class="col-md-3">
                                 <button type="button" ng-click="generarReporteInteres()" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-gears fa-lg"></i> Reporte Intereses Mora Liquidado
                                </button>
                            </div>             
                            
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/interes.mora.angular.js')}}"></script>
{% endblock %}
