{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/isteven-multi-select.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %} Reporte de edades de cartera - {{empresa}}  {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="CarteraController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Parametros del reporte</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3> Informacion requerida para la ejecucion del reporte</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-md-6 form-group " show-errors>
                                    <label for="codigoProyecto">Proyecto</label>
                                    <select class="form-control input-sm" ng-model="info.codigoProyecto" id="codigoProyecto" required="required" name="codigoProyecto">
                                        <option value="" disabled selected>Seleccione Proyecto</option>
                                        <option value="-1">Todos los proyectos</option>
                                        {% for municipio in municipios %}
                                            <option value="{{ municipio.idmunicipio }}">{{municipio.municipio}}</option>
                                        {% endfor %}                        
                                    </select>
                                    <p class="help-block" ng-if="reporte.codigoProyecto.$error.required" >
                                        El proyecto es requerido
                                    </p>
                                </div>
                                <div class="col-md-6 form-group " show-errors>
                                    <label>Fecha de corte</label>
                                    <input class="form-control datepicker input-sm" ng-model="info.fechaCorte" id="fechaCorte" name="fechaCorte" required="true" />
                                    <p class="help-block" ng-if="reporte.fechaCorte.$error.required" >
                                        La fecha de corte es requerida
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <legend>Seleccion de conceptos</legend>
                                <div class="form-group col-md-6" show-errors>
                                    <label>Liquidacion</label>
                                    <input type="text" placeholder="Nombre liquidacion" name="liquidacion_nombre" id="liquidacion_nombre" ng-model="infoTable.liquidacion_nombre" class="form-control input-sm"/>
                                </div>
                                <div class="form-group col-md-6" show-errors>
                                    <label>Nombre del concepto</label>
                                    <input type="text" placeholder="Nombre concepto" name="concepto_nombre" id="concepto_nombre" ng-model="infoTable.concepto_nombre" class="form-control input-sm"/>
                                </div>
                            </div> 
                            <div class="row">
                                <div class="col-md-4 col-md-offset-8">
                                    <button ng-click="reload()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-search fa-1x"></i> Buscar conceptos
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                    <table ng-table-dynamic="ngTable with columnas" class="table table-condensed table-responsive">                                    
                                        <colgroup>
                                            <col ng-repeat="col in $columns" width="{[{col.width}]}%"/>                                            
                                        </colgroup>
                                        <tr ng-repeat="row in $data" ng-click="seleccionarFila(row)" id="tr_{[{row.concepto_codigo}]}">
                                            <td ng-repeat="col in $columns">
                                                <span ng-show="col.option==null">
                                                    {[{row[col.field] | uppercase }]}
                                                </span>
                                                <span ng-show="col.option==true">
                                                    <a ng-click="addConcepto(row)">Agregar</a>
                                                </span>
                                            </td>                                            
                                        </tr>
                                    </table> 
                                </div>
                                <div class="col-lg-12">
                                    <legend>Conceptos seleccionados</legend>
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr>
                                                <th>Codigo</th>
                                                <th>Nombre</th>
                                                <th>Concepto</th>
                                            </tr>
                                        </thead>
                                        <tr ng-repeat="con in conceptos">
                                            <td>{[{con.codigo}]}</td>
                                            <td>{[{con.nombre}]}</td>
                                            <td><a ng-click="removerConcepto(con)">Remover</a></td>
                                        </tr>
                                    </table>                                    
                                </div>
                            </div>

                        </div>
                        <div class="panel-footer">    
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="alert-box info">
                                        Para generar este reporte de click el boton, generar reporte, este sera presentado en formato Excel.<br/>
                                    </div>  
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-2 col-md-offset-10">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(2)">
                                        <i class="fa fa-file-pdf-o fa-lg"></i> Generar reporte
                                    </button>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ng-table.mod.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/edadesCartera.control.angular.js')}}"></script>
{% endblock %}
