{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte de recuperacion y efectividad de cartera - {{empresa}}  {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="CarteraController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Parametros del reporte</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3> Ingrese los datos necesarios para la generacion del formato de arqueo de caja.</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Municipio</label>
                                        <select multiple type="text" name="municipio" id="municipio" ng-model="info.municipio" class="form-control">
                                            <!--option value="all">Todos los municipios</option-->
                                            <option ng-repeat="item in municipios" ng-value="item.idmunicipio">{[{item.municipio}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.municipio.$error.required">
                                            El municipio es requerido
                                        </p>
                                    </div>
                                    
                                    <div class="col-md-2 form-group">
                                        <label>Todos los ciclos</label>
                                        <select ng-model="todosCiclos" class="form-control input-sm">
                                            <option value="0">NO</option>
                                            <option value="1">SI</option>                                            
                                        </select>
                                    </div>
                                    
                                    <div class="col-md-4 form-group" show-errors>
                                        <label for="fechaConsulta1">Periodo de Consulta (yyyy-mm-dd):</label>
                                        <input class="form-control datepicker input-sm" ng-model="info.fechaConsulta" id="fechaConsulta" name="fechaConsulta" required="true"/>
                                        <p class="help-block" ng-if="reporte.fechaConsulta.$error.required" >
                                            La fecha de consulta es requerida
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-12" uib-collapse="todosCiclos==1">
                                    <div class="col-lg-6">
                                        <label>Seleccion de ciclos</label> &nbsp;
                                        <table ng-table="ngTable" class="table table-condensed table-responsive">                                    
                                            <tr ng-repeat="row in $data">
                                                <td data-title="'Id Ciclo'">{[{row.idciclo}]}</td>
                                                <td data-title="'Ciclo'" >{[{row.ciclo}]}</td>
                                                <td data-title="'Opcion'" >
                                                    <a ng-click="agregarCiclo(row)">
                                                        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Agregar
                                                    </a>
                                                </td>
                                            </tr>
                                        </table> 
                                    </div>
                                    <div class="col-lg-6">
                                        <label>Ciclos Seleccionados</label> &nbsp;
                                        <table ng-table="ngTable2" class="table table-condensed table-responsive">                                    
                                            <tr ng-repeat="row in $data">
                                                <td data-title="'Id Ciclo'">{[{row.idciclo}]}</td>
                                                <td data-title="'Ciclo'" >{[{row.ciclo}]}</td>
                                                <td data-title="'Opcion'" >
                                                    <a ng-click="removerCiclo(row)">
                                                        <span class="glyphicon glyphicon-minus" aria-hidden="true"></span> Remover
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel-footer">    
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="alert-box info">
                                        Este reporte puede ser generado de dos formas, la primera en formato Excel, para efectos de liquidacion de honorarios de la gestora,

                                    </div>  
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(1)">
                                        <i class="fa fa-file-excel-o fa-lg"></i> Reporte Recuperacion
                                    </button>
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(2)">
                                        <i class="fa fa-file-pdf-o fa-lg"></i> Reporte Efectividad
                                    </button>
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(3)">
                                        <i class="fa fa-file-pdf-o fa-lg"></i> Gestion de Cobro
                                    </button>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ui-bootstrap-tpls-1.3.2.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular-animate.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ng-table.mod.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/recuperacionCartera.control.angular.js')}}"></script>
{% endblock %}
