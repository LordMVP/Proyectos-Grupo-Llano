{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />    
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}

{% block titulo %}Recaudos: Consulta de Devolucion {{empresa}}  {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="devolucionesController">
        <form name="reporte" novalidate="true" >
            <fieldset>
                <legend>Busquedad de recaudo por suscripcion.</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3>Busquedad de devoluciones, impresion de comprobante de devolucion.</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="form-group col-md-4" show-errors>
                                    <label>Suscripcion o codigo anterior</label>
                                    <input type="text" name="suscripcion" id="suscripcion" ng-model="info.valorBusqueda" class="form-control input-sm"/>
                                    <p class="help-block" ng-if="reporte.suscripcion.$error.required">
                                        El numero de suscripcion o su codigo anterior son requeridos.
                                    </p>
                                </div>
                                <div class="form-group col-md-4" show-errors>
                                    <label>Fecha de Inicio</label>
                                    <input class="form-control datepicker input-sm" name="fechaInicio" type="text" id="fechaInicio" ng-model="info.fechaInicio" />
                                    <p class="help-block" ng-if="reporte.fechaInicio.$error.required">
                                        La fecha de inicio es requerida.
                                    </p>
                                </div>
                                <div class="form-group col-md-4" show-errors>
                                    <label>Fecha de Fin</label>
                                    <input class="form-control datepicker input-sm" name="fechaFinal" type="text" id="fechaFinal" ng-model="info.fechaFinal"/>
                                    <p class="help-block" ng-if="reporte.fechaFinal.$error.required">
                                        La fecha de final es requerida.
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-md-offset-8">
                                    <!--button ng-click="reload()" class="btn btn-primary btn-sm pull-right"-->
                                    <button ng-click="buscarDevoluciones()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-search fa-1x"></i> Buscar Ordenes
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                            <hr/>
                            <h3>Resultados de la busquedad</h3>
                            <br/>
                            <div class="row">
                                <div class="col-md-12">                                    
                                    <table ng-table-dynamic="ngTable with columnas" class="table">
                                    <!--table ng-table="" class="table" >
                                    
                                        <!--colgroup>
                                            <col ng-repeat="col in $columns" width="{[{col.width}]}%"/>
                                        </colgroup-->
                                        <thead>
                                            <th field="recaudo_id" width="5%">Recaudo</th>
                                            <th field="recaudo_fecha" width="15%">F. Recaudo</th>
                                            <th field="tercero_documento" width="20%">Tercero Documento</th>
                                            <th field="tercero_nombre" width="40%">Tercero Nombre</th>
                                            <th field="recaudo_valor" width="20%">Valor Recaudo</th>
                                        </thead>
                                        
                                        <tbody>
                                            <tr ng-repeat="row in $columns" ng-click="seleccionarFila(row)" id="tr_{[{row.recaudo_id}]}">
                                                <td>{[{row.recaudo_id}]}</td>
                                                <td>{[{row.recaudo_fecha}]}</td> 
                                                <td>{[{row.tercero_documento}]}</td> 
                                                <td>{[{row.tercero_nombre}]}</td> 
                                                <td>{[{row.recaudo_valor}]}</td> 

                                                <!--td ng-repeat="col in $columns">{[{row[col.field] | uppercase }]}</td-->                                                
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="col-md-9">
                                <div class="alert-box info">
                                    Al ingresar y validar todos los parametros necesarios y correctos, de clic en el boton Generar Reporte.
                                </div>                                
                            </div>
                            <div class="col-md-3">
                                <button ng-disabled="selected==null" ng-click="generarReporte();" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-search fa-1x"></i> Imprimir Devolucion
                                </button>
                            </div>
                            <div class="clearfix"/>
                        </div>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}    
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ng-table.mod.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/devolucion.control.angular.js')}}"></script>
{% endblock %}