{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />    
{% endblock %}
{% block titulo %}Reporte gestion de cartera - Generacion de cartas  - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="carteraController">
        <form name="reporte" novalidate >
            <div id="divPanelContenedor">
                <fieldset>  
                    <legend>Generacion de cartas relacionadas a la gestion de cartera</legend>
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3> Parametros para la generacion de informacion</h3>
                            </div>
                            <div class="panel-body"> 
                                <div class="row">
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Tipo de carta</label>
                                        <select required="true" id="tipoCarta" name="tipoCarta" ng-model="info.tipoCarta" class="form-control input-sm">
                                            <option value="1">Cartas gestion cartera V/cio y Mpios - Yopal (Mora Menor a 4)</option>
                                           <option value="2">Cartas gestion cartera V/cio - Yopal (Mora Mayor o Igual a 4)</option>
                                           <option value="3">Cartas gestion cartera Municipios (Mora Mayor o Igual a 4)</option>
                                           <option value="4">Carta centrales de riesgo Villavicencio - Yopal</option>  
                                           <option value="5">Carta centrales de riesgo Municipios</option>
                                           <option value="6">Comunicado de cobro</option> 
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoCarta.$error.required">
                                            El tipo de carta es requerida
                                        </p>
                                    </div>                                   
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Fecha de corte o generacion</label>
                                        <input type="text" id="fechaCorte" name="fechaCorte" ng-model="info.fechaCorte" required="true" class="input-sm form-control datepicker"/>
                                        <p class="help-block" ng-if="reporte.fechaCorte.$error.required">
                                            La fecha de corte es requerida.
                                        </p>
                                    </div>
                                    <div class="form-group col-md-3" show-errors>
                                        <label>Morosidad (Min)</label>
                                        <input type="number" id="morosidadMinima" name="morosidadMinima" ng-model="info.morosidadMinima" required="true" class="input-sm form-control"/>
                                        <p class="help-block" ng-if="reporte.morosidadMinima.$error.required">
                                            El valor minimo de la morosidad es requerdido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-3" show-errors>
                                        <label>Morosidad (Max)</label>
                                        <input type="number" id="morosidadMaxima" name="morosidadMaxima" ng-model="info.morosidadMaxima" required="true" class="input-sm form-control"/>
                                        <p class="help-block" ng-if="reporte.morosidadMaxima.$error.required">
                                            El valor maximo de la morosidad es requerdido
                                        </p>                                        
                                    </div>
                                    <div class="form-group col-md-3" show-errors>
                                        <label>Valor deuda (Min)</label>
                                        <input type="number" id="valorMinimo" name="valorMinimo" ng-model="info.valorMinimo" required="true" class="input-sm form-control"/>
                                        <p class="help-block" ng-if="reporte.valorMinimo.$error.required">
                                            El valor minimo es requerido.
                                        </p>
                                    </div>
                                    <div class="form-group col-md-3" show-errors>
                                        <label>Valor deuda (Max)</label>
                                        <input type="number" id="valorMaximo" name="valorMaximo" ng-model="info.valorMaximo" required="true" class="input-sm form-control"/>
                                        <p class="help-block" ng-if="reporte.valorMaximo.$error.required">
                                            El valor maximo es requerido.
                                        </p>
                                    </div>

                                    <div class="form-group col-md-6" show-errors>
                                        <label>Proyecto</label>
                                        <select required="true" id="proyecto" name="proyecto" ng-model="info.proyecto" class="form-control input-sm">
                                            <option value="-1">Todos los proyectos</option>
                                            {%for item in municipios%}
                                                <option value="{{item.idmunicipio}}">{{item.municipio}}</option>
                                            {%endfor%}
                                        </select>
                                        <p class="help-block" ng-if="reporte.proyecto.$error.required">
                                            El proyecto es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Tipo de uso</label>
                                        <select required="true" id="tipoUso" name="tipoUso" ng-model="info.tipoUso" class="form-control input-sm">
                                            <option value="-1">Todos los tipos de uso</option>
                                            <option ng-repeat="tipoUso in tiposUso" ng-value="tipoUso.tipo_uso_id">{[{tipoUso.tipo_uso_nombre}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.tipoUso.$error.required">
                                            El tipo de uso es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Ciclo</label>
                                        <select required="true" id="ciclo" name="ciclo" ng-model="info.ciclo" ng-change="cambiarCiclo()" class="form-control input-sm">
                                            <option value="-1">Todos los ciclos</option>
                                            {%for item in ciclos%}
                                                <option value="{{item.idciclo}}">{{item.ciclo}}</option>
                                            {%endfor%}
                                        </select>
                                        <p class="help-block" ng-if="reporte.ciclo.$error.required">
                                            El ciclo es requerido
                                        </p>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Ruta</label>
                                        <select required="true" id="ruta" name="ruta" ng-model="info.ruta" class="form-control input-sm">
                                            <option value="-1">Todas las rutas</option>
                                            <option ng-repeat="ruta in rutas" ng-value="ruta.idruta">{[{ruta.nombre}]}</option>                                            
                                        </select>
                                        <p class="help-block" ng-if="reporte.ruta.$error.required">
                                           La ruta es requerida
                                        </p>
                                    </div>
  
                                </div>                                   
                            </div>                            
                            <div class="panel-footer">  
                                <div class="row">
                                    <div class="form-group col-md-2 col-md-offset-8">
                                       <button ng-click="download=true;descargarFormato({{idempresa}})" class="btn btn-primary btn-sm pull-right">
                                           <i class="fa fa-file-word-o fa-1x"></i> Descargar Formato
                                       </button>
                                   </div>

                                    <div class="form-group col-md-2">
                                        <button ng-click="download=true;generarReporte()" class="btn btn-primary btn-sm pull-right">
                                            <i class="fa fa-gears fa-1x"></i> Generar Reporte
                                        </button>
                                    </div>               
                                    <div class="clearfix"></div>
                                </div>        
                            </div>
                        </div>
                    </div>                
                </fieldset>
            </div>
        </form>        
    </div>
{% endblock %}

{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/moment-with-locales.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/cartasGestionCartera.control.angular.js')}}"></script>
{% endblock %}