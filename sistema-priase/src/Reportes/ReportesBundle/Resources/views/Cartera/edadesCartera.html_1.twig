{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/isteven-multi-select.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte de edades de cartera - {{empresa}}  {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="CarteraController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Parametros del reporte</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3> Informacion requerida para la ejecucion del reporte</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="form-group col-md-4" show-errors>
                                    <label>Liquidacion</label>
                                    <select required="true" id="ciclo" ng-change="actualizarConceptos()" name="liquidacion" ng-model="info.liquidacion" class="form-control">
                                        <option ng-repeat="liquidacion in liquidaciones" ng-value="liquidacion.id">{[{liquidacion.label}]}</option>
                                    </select>
                                    <p class="help-block" ng-if="reporte.liquidacion.$error.required">
                                        La liquidacion es requerida
                                    </p>
                                </div>
                                <div class="form-group col-md-4" show-errors>
                                    <label>Conceptos planos</label>
                                    <div     
                                        isteven-multi-select
                                        input-model="conceptosPlanos"
                                        output-model="conceptosPlanosSeleccionados"
                                        button-label="label"
                                        item-label="label"
                                        max-labels="1"
                                        tick-property="ticked"
                                        translation="localLang"
                                        >
                                    </div>                                    
                                    <p class="help-block" ng-if="reporte.periodo.$error.required">
                                        Debe seleccionar algun concepto
                                    </p>
                                </div> 
                                <div class="form-group col-md-4" show-errors>
                                    <label>Conceptos interes</label>
                                    <div     
                                        translation="localLang"
                                        isteven-multi-select
                                        input-model="conceptosInteres"
                                        output-model="conceptosInteresSeleccionados"
                                        button-label="label"
                                        item-label="label"
                                        max-labels="1"
                                        tick-property="ticked"
                                        >
                                    </div>                                    
                                    <p class="help-block" ng-if="reporte.periodo.$error.required">
                                        Debe seleccionar algun concepto
                                    </p>
                                </div>
                            </div>    

                        </div>
                        <div class="panel-footer">    
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="alert-box info">
                                            Para generar este reporte de click el boton, generar reporte, este sera presentado en formato Excel.<br/>

                                    </div>  
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-primary btn-sm" ng-click="generarReporte(2)">
                                        <i class="fa fa-file-pdf-o fa-lg"></i> Generar reporte
                                    </button>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/isteven-multi-select.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/edadesCartera.control.angular.js')}}"></script>
{% endblock %}
