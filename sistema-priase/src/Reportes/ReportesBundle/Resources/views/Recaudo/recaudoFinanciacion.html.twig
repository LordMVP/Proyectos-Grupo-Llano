{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />    
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}

{% block titulo %}Recaudos de Financiaciones {{empresa}}  {% endblock %}

{% block body %}
    <div id="module" ng-app="myApp" ng-controller="recaudoFinanciacionController as reportecontrol">
        <form name="reporte" novalidate="true" >
            <fieldset>
                <legend>Filtros de búsqueda</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">

                            <div class="form-group col-md-4" show-errors>
                                <label>Fecha de Inicio: </label>
                                <input class="form-control datepicker input-sm" name="fechaInicio" type="text" id="fechaInicio" ng-model="fechaInicio" ng-change="reportecontrol.validarFechaFinal()" required="required" />
                                <p class="help-block">
                                    Debe selecionar la fecha inicial
                                </p>
                            </div>
                            <div class="form-group col-md-4" show-errors>
                                <label>Fecha de Fin: </label>
                                <input class="form-control datepicker input-sm" name="fechaFinal" type="text" id="fechaFinal" ng-model="fechaFin" required="required" />
                                <p class="help-block" >
                                    La fecha de final es requerida.
                                </p>
                            </div>
                            <div class="form-group col-md-4" style="display: initial; top: 21px;">
                                <button ng-click="reportecontrol.generarReporte();" class="btn btn-primary btn-sm">
                                    <i class="fa fa-gears fa-lg"></i> Generar Reporte
                                </button>
                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="col-md-9">
                                <div class="alert-box info">
                                    Ingrese un rango de fechas para buscar los recaudos y de clic sobre el botón <b>Generar reporte</b>
                                </div>                                
                            </div>

                            <div class="clearfix"/>
                        </div>
                    </div>
                </div>
                </div>
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}    
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/recaudoFinanciacion.angular.js')}}"></script>
{% endblock %}