{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte Bioagricola Dia -{{empresa}} {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="BioRecaudoController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend>Parametros del reporte</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-md-4 form-group" show-errors>
                                    <label for="fechaConsulta1">Fecha de Consulta (yyyy-mm-dd):</label>
                                    <input class="form-control datepicker input-sm" ng-model="info.fechaInicial" id="fechaInicial" name="fechaInicial" required="true" />
                                    <p class="help-block" ng-if="reporte.fechaConsulta.$error.required" >
                                        La fecha de consulta es requerida
                                    </p>
                                </div>
                                   
                            </div>
                           
                                                             
                           
                        </div>
                        <div class="panel-footer">    
                            <div class="col-md-8">
                                <div class="alert-box info">
                                    Al ingresar y validar todos los parametros necesarios y correctos, de clic en el boton Generar Reporte.
                                </div>  
                            </div>
                            <div class="col-md-2">
                                <button type="button" ng-click="generarReporte(1)" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-gears fa-lg"></i>  Pagos Cajas
                                </button>
                            </div> 
                            <div class="col-md-2">
                                <button type="button" ng-click="generarReporte(2)" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-gears fa-lg"></i>  Pagos PSE
                                </button>
                            </div>               
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/cartera/recaudo.biodiario.angular.js')}}"></script>
{% endblock %}
