{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />
{% endblock %}
{% block titulo %}Reporte Informacion de Tarifas para FES  -{{empresa}} {% endblock %}

{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="TarifasFESController">
        <form name="reporte" id="reporte" method="post" novalidate>
            <fieldset>
                <legend> Generar Plano TFES </legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-body">                            
                            <div class="row">
                                <div class="col-md-2 form-group" show-errors>            
                                </div>
                                <div class="col-md-3 form-group" show-errors>
                                    <label for="fechaConsulta1">Periodo Consulta (yyyy-mm-dd):</label>
                                    <input class="form-control datepicker input-sm" ng-model="info.fechaConsulta1" id="fechaConsulta1" name="fechaConsulta1" required="true"/>
                                    <p class="help-block" ng-if="reporte.fechaConsulta1.$error.required" >
                                        La fecha de consulta es requerida
                                    </p>
                                </div> 
                                <div class="col-md-3 form-group" show-errors>
                                    <label for="intMorDom">Interes Mora Domiciliario (0.0XXX):</label>
                                    <input type="number" min="0" max="1" class="form-control input-sm" ng-model="info.intMorDom" id="intMorDom" name="intMorDom" required="true"/>
                                    <p class="help-block" ng-if="reporte.intMorDom.$error.required" >
                                        El Interes de mora Domicilizario es obligatorio
                                    </p>
                                </div>
                                <div class="col-md-3 form-group" show-errors>
                                    <label for="intMorCom">Interes Mora Comercial (0.0XXX):</label>
                                    <input type="number" min="0" max="1" class="form-control input-sm" ng-model="info.intMorCom" id="intMorCom" name="intMorCom" required="true"/>
                                    <p class="help-block" ng-if="reporte.intMorCom.$error.required" >
                                        El Interes de mora Comercial es obligatorio
                                    </p>                              
                                </div>

                                <div class="col-md-12 form-group" >
                                    <div class="col-md-5 form-group" show-errors>                                                                       
                                    </div>                                                          
                                    <div class="col-md-3 form-group" show-errors>
                                       <label for="consEst">Consumo Estandar:</label>
                                       <input type="number" min="0" max="999" class="form-control input-sm" value="20" ng-model="info.consEst" id="consEst" name="consEst" required="true"/>
                                       <p class="help-block" ng-if="reporte.consEst.$error.required" >
                                           El Consumo Basico estandar es obligatorio
                                       </p>                              
                                    </div>                                                            
                                </div>                                                          
                            </div>  
                        </div>                                               
                        <div class="panel-footer">    
                            <div class="col-md-12">
                                <div class="alert-box info">
                                    Toda la informacion sera generada en un archivo .txt
                                </div>  
                            </div>                            
                            <div class="col-md-3">
                                <button type="button" ng-click="generarReporte()" class="btn btn-primary btn-sm pull-right">
                                    <i class="fa fa-gears fa-lg"></i> Generar Reporte
                                </button>
                            </div> 
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>                
            </fieldset>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/tarifas/tarifasFES.angular.js')}}"></script>
{% endblock %}
