{% extends "::base.html.twig" %}
{% block stylesheets %}

    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />    
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/ng-table.min.css')}}" />    
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" /> 
{% endblock %}
{% block scripts %}
    <script type="text/javascript" src="/achagua/js/jquery.dataTables.min.js"></script>
{% endblock %}   
{% block titulo %}Generacion Reporte Constructoras - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="ventasController">
        <form name="reporte" novalidate >
            <fieldset>  
                <legend>Generacion Reporte Constructoras</legend>
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3> Ingrese alguno de los parámetros para realizar la búsqueda de la amortizacion</h3>
                        </div>
                        <div class="panel-body" id="panelBody">
                            <div class="row">
                                <div class="form-group col-md-3">
                                    <label>nit Constructora</label>
                                    <input min="0" type="number" placeholder="nit Constructora" name="documento" id="documento" ng-model="info.documento" class="form-control input-sm"/>
                                </div>
                                <div class="form-group col-md-3">
                                    <label>Contrato</label>
                                    <input type="text" placeholder="# Contrato" name="contrato" id="contrato" ng-model="info.contrato" class="form-control input-sm"/>
                                </div>
                                <div class="form-group col-md-6" show-errors>
                                    <label>Constructora nombre o id</label>
                                    <input type="text" ng-model="info.constructora_id" placeholder="Nombre de la constructora" uib-typeahead="resultados.id as resultados.label for resultados in buscarAu($viewValue)" typeahead-loading="loadingLocations" typeahead-no-results="noResults" typeahead-template-url="auTemplate.html" typeahead-wait-ms="300" class="form-control input-sm"/>
                                    <p class="help-block-show" ng-show="loadingLocations" >
                                        <i class="fa fa-refresh"></i> Cargando resultados
                                    </p>
                                    <p class="help-block-show" ng-show="noResults" >
                                        <i class="fa fa-remove"></i> No se han encontrado resultados 
                                    </p>
                                </div> 
                            </div> 
                            <div class="row">
                                <div class="col-md-4 col-md-offset-8">
                                    <button ng-click="reload()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-search fa-1x"></i> Buscar Amortizaciones
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                            <hr/>  
                            <h3 style="font-size: 15px;">Resultados de la busquedad</h3>
                            <br/>
                            <div class="row">
                                <div class="col-md-12">                                        
                                    <table ng-table-dynamic="ngTable with columnas" class="table table-condensed">                                    
                                        <colgroup>
                                            <col ng-repeat="col in $columns" width="{[{col.width}]}%"/>                 
                                        </colgroup>
                                        <tr ng-repeat="row in $data" ng-click="seleccionarFila(row)" id="tr_{[{row.numero_orden}]}">
                                            <td ng-repeat="col in $columns">{[{row[col.field] | uppercase }]}</td>
                                            
                                        </tr>                           
                                    </table> 

                                </div>
                            </div>
                        </div>                            
                        <div class="panel-footer">    
                            <div class="col-md-9">
                                <div ng-show="total!=0" class="alert-box info">
                                    Seleccione un contrato de la constructora haciendo clic sobre la fila seleccionada.
                                </div>
                                <div ng-show="total==0" class="alert-box error">
                                    No se encontraron resultados para el numero nit o documento [ {[{info.numero_orden}]} {[{info.numeroDocumento}]} ]
                                </div>
                            </div>
                            <div class="col-md-4 col-md-offset-8">
                                    <button ng-disabled="selected==null" type="button" class="btn btn-primary btn-sm pull-right" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-gears fa-lg"></i> Generar reporte  <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu">                                                                              
                                        <li>
                                            <a ng-click="download=true;generarReporte()">
                                                <i class="fa fa-file-pdf-o fa-lg"></i> Imprimir General
                                            </a>
                                        </li>
                                        <li>
                                            <a ng-click="download=true;generarReporte2()">
                                                <i class="fa fa-file-excel-o fa-lg"></i> Imprimir Detallado
                                            </a>
                                        </li>  
                                    </ul>
                                </div> 
                                          
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>
            </fieldset>            
        </form> 
        <script type="text/ng-template" id="auTemplate.html">
            <a>        
            <span style="font-size:10px;" ng-bind-html="match.model.label | uibTypeaheadHighlight:query"></span>                
            </a>
        </script>
    </div>

{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ng-table.mod.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/autocomplete/ui-bootstrap-tpls-0.14.3.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/ventas/ventasConstructoras.control.angular.js')}}"></script>
{% endblock %}