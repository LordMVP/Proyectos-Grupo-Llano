{% extends "::base.html.twig" %}
{% block stylesheets %}

    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />    
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/ng-table.min.css')}}" />    
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" /> 
{% endblock %}
{% block scripts %}
    <script type="text/javascript" src="/achagua/js/jquery.dataTables.min.js"></script>
{% endblock %}   
{% block titulo %}Generacion de formato de orden de trabajo - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="ventasController">
        <form name="reporte" novalidate >
            <div id="divPanelContenedor">
                <fieldset>  
                    <legend>Generacion de formato de orden de trabajo</legend>
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3> Parametros necesarios para la generacion del formato</h3>
                            </div>
                            <div class="panel-body" id="panelBody">                                 
                                <div class="row">
                                    <div class="form-group col-md-4">
                                        <label>Numero de orden de trabajo</label>
                                        <input min="0" type="number" name="numeroOrden" id="numeroOrden" ng-model="info.numeroOrden" class="form-control input-sm"/>
                                    </div>
                                    <div class="form-group col-md-6" show-errors>
                                        <label>Nombre de la constructora</label>
                                        <input type="text" ng-model="constructora" placeholder="Ingrese el nombre de la constructora" uib-typeahead="resultados as resultados.label for resultados in buscarAu($viewValue)" typeahead-loading="loadingLocations" typeahead-no-results="noResults" typeahead-template-url="auTemplate.html" typeahead-wait-ms="300" class="form-control input-sm"/>
                                        <p class="help-block-show" ng-show="loadingLocations" >
                                            <i class="fa fa-refresh"></i> Cargando resultados
                                        </p>
                                        <p class="help-block-show" ng-show="noResults" >
                                            <i class="fa fa-remove"></i> No se han encontrado resultados 
                                        </p>
                                    </div>                                    
                                </div>                                   
                            </div>                            
                            <div class="panel-footer">                                
                                <div class="col-md-4 col-md-offset-8">
                                    <button ng-click="download=true;buscarOrdenTrabajo()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-search fa-1x"></i> Buscar Ordenes
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3>Resultados, solo se visualizan las ultimas 5 ventas</h3>
                            </div>
                            <div class="panel-body">                                 
                                <table ng-table-dynamic="info with columnas" class="table table-condensed table-striped">                                    
                                    <colgroup>
                                        <col ng-repeat="col in $columns" width="{[{col.width}]}%"/>
                                    </colgroup>
                                    <tr ng-repeat="row in $data">
                                        <td ng-repeat="col in $columns">{[{row[col.field] | uppercase }]}</td>
                                        <td title="Opcion">Hola</td>
                                    </tr> 
                                </table>  
                                <div class="clearfix"/>
                            </div>
                            <div class="panel-footer">               
                                <div class="col-md-9">
                                    <b>Venta: </b> {[{selected.venta_id}]}
                                    <br/>
                                    <b>Fec. Venta: </b>{[{selected.venta_fecha}]}
                                    <br/>
                                    <b>Nom. Cliente: </b>{[{selected.tercero_nombre}]}
                                    <br/>                                   
                                </div>
                                <div class="col-md-3">
                                    <button ng-disabled="selected==null" ng-click="download=true;generarReporte()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-print fa-1x"></i> Imprimir Orden
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </form> 
        <script type="text/ng-template" id="auTemplate.html">
            <a>        
            <span ng-bind-html="match.model.label | uibTypeaheadHighlight:query"></span>                
            </a>
        </script>
    </div>

{% endblock %}

{% block javascripts %}

    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/ng-table.mod.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/ventas/ordenTrabajo.control.angular.js')}}"></script>
{% endblock %}