{% extends "::base.html.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/main.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Reportes/css/main/bootstrap.css')}}" />    
{% endblock %}
{% block titulo %}Generacion de formato de factura de venta - {{empresa}}  {% endblock %}
{% block body %}
    <div style="display: none" id="module" ng-app="myApp" ng-controller="ventasController">
        <form name="reporte" novalidate >
            <div id="divPanelContenedor">
                <fieldset>  
                    <legend>Generacion de formato de factura de venta</legend>
                    <div class="col-md-12">
                        <div class="panel panel-primary">
                            <div class="panel-heading">
                                <h3> Parametros necesarios para la generacion del formato</h3>
                            </div>
                            <div class="panel-body"> 
                                <div class="row">
                                    <div class="form-group col-md-3" show-errors>
                                        <label>Numero de la Venta</label>
                                        <input type="number" name="numeroVenta" id="numeroVenta" ng-model="info.numeroVenta" class="form-control input-sm"/>
                                        
                                    </div>
                                    <div class="form-group col-md-4" show-errors>
                                        <label>Documento del suscriptor</label>
                                        <input type="number" name="documentoSuscritor" id="documentoSuscritor" ng-model="info.documentoSuscritor" class="form-control input-sm"/>
                                        
                                    </div>
                                    <div class="form-group col-md-4" show-errors>
                                        <label>ID suscripcion</label>
                                        <input type="number" name="idsuscripcion" id="idsuscripcion" ng-model="info.idsuscripcion" class="form-control input-sm"/>
                                        
                                    </div>
                                </div>                                   
                            </div>                            
                            <div class="panel-footer">                                
                                <div class="col-md-4 col-md-offset-8">
                                    <button ng-click="download=true;generarReporte()" class="btn btn-primary btn-sm pull-right">
                                        <i class="fa fa-gears fa-1x"></i> Generar Reporte
                                    </button>
                                </div>               
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>                
                </fieldset>
            </div>
        </form>        
    </div>
{% endblock %}

{% block javascripts %}     
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/angular.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/showErrors.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/bootstrap.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/main/main.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Reportes/js/ventas/facturaVenta.control.angular.js')}}"></script>
{% endblock %}