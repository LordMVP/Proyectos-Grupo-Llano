{% extends "::base.html.twig" %}

{% block stylesheets %}

    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="/achagua/css/appload.css" />
    <style>
        .label-enlinea{
            display: inline !important;
            margin-right: 15px;
        }
        .file-item-desc{
            width: 50%;
        }
        .file-item-btns {
            width: 43%;
        }

        .file-item:nth-child(2n+1) {
            background-color: inherit !important; 
        }
        .campodoble{
            display: inline-block;
            width: 65%
        }
        .campo-linea{
            width: 45%;
            display: inline-block;
        }
        .campo-linea label{
            display: inline-block;
        }
        .campo-linea input{
            width: 25%;
            margin-right: 10px;
            margin-top: 10px;
            display: inline-block;
        }
    </style>
{% endblock %}

{% block scripts %}
{% endblock %}

{% block titulo %} Validar Solicitud- {{empresa}}  {% endblock %}
