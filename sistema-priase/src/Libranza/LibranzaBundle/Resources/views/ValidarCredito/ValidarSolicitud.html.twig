                            <input type="text" data-reference="entidadfinanciera" id="txtEntidadFinanciera">        
                        </div>

                        <div class="campo">
                            <label for="cmbTipoCuentaDesembolso">Tipo de Cuenta:</label>
                            <select id="cmbTipoCuentaDesembolso" data-reference="tipocuentadesembolso" required="required">
                                <option value="A">Cuenta de Ahorros</option>
                                <option value="C">Cuenta Corriente</option>
                            </select>
                        </div>

                        <div class="campo">
                            <label for="txtNumeroCuento">No. Cuenta:</label>
                            <input type="text" id="txtNumeroCuento" data-reference="numerocuenta" required="required">
                        </div>
                    </div>
                </div>

                <div class="divContenedorColapsable">
                    <div class="divColapsable">
                        <h3 class="tituloColapsable">POLIZA DE SEGURO</h3>
                        <div class="btnColapsable"><a href="" class="fa fa-minus" tabindex="-1"></a></div>
                    </div>
                    <div class="contenidoColapsable">
                        <div class="campo">
                            <label for="txtBeneficiario">Nombre del Beneficiario:</label>
