                        </div>
                        <div class="campo">
                            <label for="cmbTipoDocumentoBeneficiario">Tipo Identificación:</label>
                            <select id="cmbTipoDocumentoBeneficiario"  required="required" disabled="disabled">
                                <option value="NI">NIT</option>
                            </select>
                        </div>

                        <div class="campo">
                            <label for="txtNumeroDocBeneficiario">No. Documento:</label>
                            <input type="text" id="txtNumeroDocBeneficiario" required="required" disabled="disabled" value="900618586">
                        </div>

                        <div class="campo">
                            <label for="txtPorcentaje">Porcentaje:</label>
                            <input id="txtPorcentaje"  type="text" disabled="disabled" value="100%"/>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <fieldset style="margin: 10px 10px 10px 10px;">
            <legend>Descarga de Soportes </legend>
            <table class="tabla" data-reference="archivos">
                <thead>
                    <tr>
                        <th>Formato</th>
                        <th>Descargas de archivo</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="width:30%;">
                            <i class="fa fa-file-o fa-2x" style="font-size:14px"> </i><span> Formato Diligenciado</span>
                        </td>
                        <td style="width:70%">
                            <button data-refer="Formato" class="btn-descargar btnSimple">Descargar Archivo</button>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:30%;">
                            <i class="fa fa-file-o fa-2x" style="font-size:14px"> </i><span> Fotocopia documento al 150%</span>
                        </td>
                        <td style="width:70%">
                            <button data-refer="Documento" class="btn-descargar btnSimple">Descargar Archivo</button>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:30%;">
                            <i class="fa fa-file-o fa-2x" style="font-size:14px"> </i><span> Certificación Laboral</span>
                        </td>
                        <td style="width:70%">
                            <button data-refer="CertLab" class="btn-descargar btnSimple">Descargar Archivo</button>
                        </td>
                    </tr>

                    <tr>
                        <td style="width:30%;">
                            <i class="fa fa-file-o fa-2x" style="font-size:14px"> </i><span> Últimos desprendibles de Pago</span>
                        </td>
                        <td style="width:70%">
                            <button data-refer="DespPago" class="btn-descargar btnSimple">Descargar Archivo</button>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:30%;">
                            <i class="fa fa-file-o fa-2x" style="font-size:14px"> </i><span> Visto Bueno</span>
                        </td>
                        <td style="width:70%">
                            <button data-refer="VistoBno" class="btn-descargar btnSimple">Descargar Archivo</button>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:30%;">
                            <i class="fa fa-file-o fa-2x" style="font-size:14px"> </i><span> Autorización de Consulta y Reporte en las centrales de Riesgo.</span>
                        </td>
                        <td style="width:70%">
                            <button data-refer="Centrales" class="btn-descargar btnSimple">Descargar Archivo</button>
                        </td>
                    </tr>

                </tbody>
            </table>

        </fieldset>

    </div>

    <div id="divBuscarSolicitud" style="display:none;">
        <div id="divCuerpoBusqueda">
            <div class="campo">
                <label for="txtNumRadicadoBuscar">Nº de Radicación: </label>
                <input type="text" id="txtNumRadicadoBuscar" />
            </div>
            <div class="campo">
                <label for="txtNombreSolicitanteBuscar">Solicitante: </label>
                <input type="text" id="txtNombreSolicitanteBuscar" />
            </div>
            <div class="campo">
                <label for="txtDocumentoBuscar">Documento de identidad</label>
                <input type="text" id="txtDocumentoBuscar" />
            </div>
            <div class="campo">
                <button class="btnSimple" id="btnBuscarSolicitud">Buscar</button>
            </div>
            <div><span class="pMensaje"></span></div>
            <div id="divResultadoFiltro"></div>
        </div>
    </div>

    <div id="divRechazarSolicitud" style="display:none;">
        <label for="cmbMotivoRechazo">Motivo:</label>
        <select id="cmbMotivoRechazo">
            <option value="-1">Seleccione una opción</option>
            {% for motivo in motivorechazo %}
                <option value="{{motivo.idunidad}}">{{motivo.nombre}}</option>
            {% endfor %}
        </select>
        <label for="txtObservacionRechazo">Observaciones: </label>
        <textarea name="" id="txtObservacionRechazo" cols="30" rows="10"></textarea>
        <span class="pMensaje"></span>
    </div>

    <div id="divAprobarSolicitud" style="display:none;">
        <label for="cmbMotivo">Motivo:</label>
        <select id="cmbMotivo">
            <option value="-1">Seleccione una opción</option>
            {% for motivo in motivovalidar %}
                <option value="{{motivo.idunidad}}">{{motivo.nombre}}</option>
            {% endfor %}
        </select>
        <label for="txtObservacion">Observaciones: </label>
        <textarea name="" id="txtObservacion" cols="30" rows="10"></textarea>
        <span class="pMensaje"></span>
    </div>

