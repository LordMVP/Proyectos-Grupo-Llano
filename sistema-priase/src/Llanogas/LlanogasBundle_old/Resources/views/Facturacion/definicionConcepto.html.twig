        </div>
        <div class="campo">
            <label for="txtRangoFinal">Rango final: </label>
            <input type="text" id="txtRangoFinal" />
        </div>
        <div class="campo">
            <label for="cmbAccionRango">Acción: </label>
            <select id="cmbAccionRango" required="required">
                <option value="-1">Seleccione una opción</option>
                <option value="V" selected>Valor</option>
                <option value="F">Fórmula</option>
            </select>
        </div>
        <div class="campo">
            <label for="txtValorFormula" id="lblValorFormula">Valor: </label>
            <input type="text" id="txtValorFormula" data-text="" />
        </div>
        <div class="campo">
            <label></label>
            <button id="btnEditarFormulaRango" style="display:none;" data-accion="I" class="btnSimple">Agregar o Editar Fórmula</button>
        </div>
        <p id="pMensajeRango" class="pMensaje"></p>
        <button class="btnSimple" id="btnAgregarRango">Agregar Nuevo Rango</button>
        <button class="btnSimple" id="btnActualizarRango" style="display: none;">Actualizar Rango</button>
        <button class="btnSimple" id="btnCancelarActualizarRango" style="display: none;">Cancelar Edición</button>
        <div style="padding:10px;">
            <table class="tabla" id="tblRangos"></table>
        </div>
    </div>
</div>

