{% extends "::base.html.twig" %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/facturacion/cargarFactorCorreccion.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.datetimepicker.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/jquery.dataTables.min.css')}}" />
    <style type="text/css">
        #divCargando {
            min-width: 100px;
            max-width: 300px;
            min-height: 40px;
            background-color: #8AB6D9;
            color: #FFF;
            font-size: 12px;
            margin: 0 auto;
            display: none;
            border-radius: 20px;
            padding-left: 20px;
            text-align: center;
            padding-top: 3px;
        }

        #divCargando p{
            margin: 7px 0px 0px 10px;
            display: inline-block;
        }
    </style>

{% endblock %}

{% block scripts %}
    <script type="text/javascript" src="/achagua/js/jquery.dataTables.min.js"></script>
{% endblock %}

{% block titulo %} Genera Plano Contacto {% endblock %}

{% block body %}

    
    
    <div id="divCabecera">
        <fieldset><legend>Generación Archivo Plano Contacto</legend>
                <div class="campo">
                    <label for="txtFechaInicial">Fecha Inicial:</label>
                    <input id="txtFechaInicial" type="text"  required="required" />
                </div>
                <div class="campo">
                    <label for="txtFechaFinal">Fecha Final:</label>
                    <input id="txtFechaFinal" type="text"   required="required" />
                </div>
            <div class="divBotones">
                <input type="button" value="generar" id="btnGenerar" class="btnSimple" />
            </div>
        </fieldset> 
        <fieldset><legend>Arhivos Generados</legend>
            <div id="divArchivos"><table id="tblArchivos" class="tabla"></table></div>
        </fieldset>         
    </div>

 
    
{% endblock %}
{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/contacto/contactoGenerar.modelo.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/contacto/contactoGenerar.control.js')}}"></script>-->
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/contacto/contactoGenerar.vista.js')}}"></script>
{% endblock %}