{% block body %}
    <div>
        <h4>Cordial Saludo </h4>
        <br>
        <p>
        Esta es una notificación de seguimiento de las Propiedades que se eliminaron en el sistema de información Prisma 
        </p>
        <br>
        <table border="1"  >
            <caption><h4>TABLA DE RESULTADOS</h4></caption>
            <thead>
                <tr style="text-align: center">
                    <th>Documento</th>
                    <th>Nombre</th>
                    <th>Direccion</th>
                    <th>IdPropiedad</th>
                    <th>IdMunicipio</th>    
                    <th>IdBarrio</th>    
                </tr>    
            </thead>
            <tbody>
                {% for registro in datos %}
                    <tr>
                        <td>{{registro.documento}}</td>
                        <td>{{registro.nomtercero}}</td>
                        <td style="text-align: right">{{registro.direccion}}</td>
                        <td>{{registro.idpropiedad}}</td>
                        <td>{{registro.nomproyecto}}</td>
                        <td>{{registro.nombarrio}}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
            <br>
            <p>
            Por favor no responda este mensaje .
            <br>
            <br>
            Atentamente 
            <br>
            <h4>Proceso Gestión de Tecnología Informática</h4>
            </p>
    </div>


{% endblock %}


