{% extends "::base.html.twig" %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/facturacion/cargarFactorCorreccion.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.datetimepicker.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/jquery.dataTables.min.css')}}" />
    <style type="text/css">
        #divCargando {
            min-width: 100px;
            max-width: 300px;
            min-height: 40px;
            background-color: #8AB6D9;
            color: #FFF;
            font-size: 12px;
            margin: 0 auto;
            display: none;
            border-radius: 20px;
            padding-left: 20px;
            text-align: center;
            padding-top: 3px;
        }

        #divCargando p{
            margin: 7px 0px 0px 10px;
            display: inline-block;
        }
    </style>

{% endblock %}

{% block scripts %}
    <script type="text/javascript" src="/achagua/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="/achagua/js/jquery.crypt.js"></script>
{% endblock %}

{% block titulo %} Facturación Fes  {% endblock %}

{% block body %}

    <div id="divProceso" style="display: none;">
        <fieldset>
            <legend>Información proceso: </legend>
            <div id="divProcesando">
                <div class="divBotones">
                    <input type="button" value="Detener Ejecucion" id="btnDetenerProceso" class="btnSimple" />
                </div>
                <div id="divCargando"> 
                    <img src="/achagua/sistema/web/bundles/Llanogas/img/cargando2.gif">
                    <p>Procesando generación Archivo Plano Fes, <br>esto puede tardar unos minutos...</p>                
                </div>
                <table id="tblEjecucion" class="tabla" style="margin: 10px;"></table>
            </div>
        </fieldset>
    </div>

    <div id="divCabecera" style="display: none;"  >
        <fieldset><legend>Iniciar Proceso Carga Fes</legend>
            <div class="divBotones">
                <input type="button" value="Activar" id="btnCargar" class="btnSimple" />
            </div>
        </fieldset> 
    </div>
    <div id="divlogin"  style="display: none;" >
                <input type="password" id="key"  placeholder="Clave" />
    </div>



{% endblock %}
{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/fes/fesCarga.modelo.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/fes/fesCarga.control.js')}}"></script>-->
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/fes/fesCarga.vista.js')}}"></script>
    <script type="text/javascript">  (function($) {
                 fesCargaModelo.usu_ideregistro= {{usu_ideregistro}} ;
            })</script>
   
{% endblock %}