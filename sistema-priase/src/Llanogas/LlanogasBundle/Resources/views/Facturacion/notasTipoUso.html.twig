{% extends "::base.html.twig" %}
{% block stylesheets %}

    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/theme/jquery.ui.all.css')}}" />
    <link rel="stylesheet" type="text/css" href="{{asset('bundles/Llanogas/css/recaudos/abonos.estilo.css')}}" />
    <link href="{{asset('bundles/Llanogas/css/facturacion/dataTables.css')}}" media="screen" type="text/css" rel="stylesheet" />
{% endblock %}
{% block scripts %}

{% endblock %}
{% block titulo %}Facturación: Notas Automáticas - Tipo de Uso  {% endblock %}
{% block body %}

    <div id="divComandos">
        <div class="divBotones">
            <input type="button" value="Procesar" id="btnProcesar" class="btn" />
            <input type="button" value="Aplicar Notas" id="btnAplicarNotas" class="btn" disabled="disabled" />
            <input type="button" value="Cancelar" id="btnCancelar" class="btn" />
        </div>
    </div>

    <div id="contenedorSuscripciones">
        <div id="divSuscripcion">
            <fieldset>
                <legend>Suscripción</legend>
                <div id="divSuscripciones">

                    <div class="campoBusqueda">
                        <label for="btnBuscarSuscripcion">Suscripción:</label>
                        <input type="text" id="txtSuscripcion" disabled="disabled" />
                        <button id="btnBuscarSuscripcion"></button>
                    </div>

                    <div class="campo">
                        <label for="txtDocumento">NIT/CC:</label>
                        <input type="text" id="txtDocumento" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtNombre">Nombre Completo:</label>
                        <input type="text" id="txtNombre" disabled>
                    </div>

                    <div class="campoCorto">
                        <label for="txtCodAnterior">Código Anterior:</label>
                        <input type="text" id="txtCodAnterior" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtSuscMunicipo">Municipo:</label>
                        <input type="text" id="txtSuscMunicipo" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtSuscBarrio">Barrio:</label>
                        <input type="text" id="txtSuscBarrio" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtDireccion">Dirección:</label>
                        <input type="text" id="txtDireccion" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtTelefono">Teléfono:</label>
                        <input type="text" id="txtTelefono" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtCelular">Celular:</label>
                        <input type="text" id="txtCelular" disabled>
                    </div>

                    <div class="campo">
                        <label for="txtSuscTipoUso">Tipo de Uso:</label>
                        <input type="text" id="txtSuscTipoUso" disabled>
                    </div>
                    <div class="campo">
                        <label for="txtLiquidacion">Liquidación:</label>
                        <input type="text" id="txtLiquidacion" disabled>
                    </div>
                    <div class="campo">
                        <label for="txtCiclo">Ciclo:</label>
                        <input type="text" id="txtCiclo" disabled>
                    </div>
                    <div class="campoCorto">
                        <label></label>
                        <button class="btnSimple" id="btnBuscarFactura" style="width:140px;">Buscar Facturas</button>
                    </div>
                </div>

            </fieldset>
        </div>
    </div>
    <div id="divFacturas">
        <table id="tblFactura" class="tabla"></table>
    </div>
    <div class="campo" style="display:none;" id="divTxtLiquidacion">
        <label for="txtLiquidacion">Liquidación:</label>
        <input type="text" id="txtLiquidacion" disabled="disabled"/>
    </div>

    <div id="filtroFacturas" style="display:none;">

        <div class="campo">
            <label for="cmbTipoDocumentoFiltro">Tipo Documento:</label>
            <select id="cmbTipoDocumentoFiltro" required="required">
                <option value="-1">Seleccione una opción</option>
            </select>
        </div>
        <div class="campo">
            <label for="cmbDocumentoFiltro">Documento:</label>
            <select id="cmbDocumentoFiltro" required="required"></select>
        </div>
        <div class="campo">
            <label for="cmbLiquidacion">Liquidación:</label>
            <select id="cmbLiquidacion" required="required"></select>
        </div>

        <div class="campo">
            <label for="cmbCantidadMeses">Cantidad de Meses:</label>
            <select id="cmbCantidadMeses" required="required">
                <option value="-1">Seleccione una opción</option>
            </select>
        </div>
        <span id="pMensajeFacturas" class="pMensaje"></span>
    </div>

    <div id="camposBuscarSuscripcion" style="display:none;" >
        <div>
            <div class="campo">
                <label for="txtFiltroMunicipo">Municipo:</label>
                <input type="text" id="txtFiltroMunicipo" />
            </div>
            <div class="campo">
                <label for="txtFiltroSus">Suscripción:</label>
                <input type="text" id="txtFiltroSus" data-attr="suscripcion" maxlength="15" />
            </div>
            <div class="campo">
                <label for="txtFiltroDoc">Cédula/NIT:</label>
                <input type="text" id="txtFiltroDoc" data-attr="documento" maxlength="20" />
            </div>
        </div>
        <div>
            <div class="campo">
                <label for="txtFiltroCodAnt">Código Anterior:</label>
                <input type="text" id="txtFiltroCodAnt" data-attr="codAnterior" maxlength="30" />
            </div>
        </div>
        <span id="spanMensaje" class="pMensaje"></span>
        <button id="btnBuscar" class="btnSimple">Buscar</button>
    </div>

    <div id="divDialogProcesando" style="display:none;">
        <div id="divCargando" style="margin-bottom: 25px; margin-top: 20px;"> 
            <img src="/achagua/sistema/web/bundles/Llanogas/img/cargando2.gif">
            <p>Procesando facturas, <br>esto puede tardar unos minutos...</p>                
        </div>
    </div>

    <div id="divDialogoErrores" style="display:none">
        <table class="tabla" id="tblErrores"></table>
    </div>

    <div id="divDialogoMotivos" style="display:none;">
        <div class="campoCompleto">
            <label for="cmbMotivo">Mótivo:</label>
            <select id="cmbMotivo"></select>
        </div>
        <div class="campoCompleto">
            <label for="txtComentario">Comentarios:</label>
            <textarea name="" id="txtComentarios"></textarea>
        </div>
    </div>

    <div id="divDialogoConceptos" style="display:none;">
        <table class="tabla" id="tblConceptosProcesados"></table>
    </div>

{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/dataTables.min.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/jquery.dataTables.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/dataTables.tableTool.js')}}"></script>


    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/notasTipoUso/notasTipoUso.modelo.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/notasTipoUso/notasTipoUso.control.js')}}"></script>
    <script type="text/javascript" src="{{asset('bundles/Llanogas/js/facturacion/notasTipoUso/notasTipoUso.vista.js')}}"></script>
{% endblock %}
