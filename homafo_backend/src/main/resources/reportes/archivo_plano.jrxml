	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bioagricola"/>
	<property name="net.sf.jasperreports.export.text.character.width" value="8"/>
	<property name="net.sf.jasperreports.export.text.character.height" value="20"/>
	<parameter name="PR_STR_FECHA1" class="java.lang.String"/>
	<parameter name="PR_STR_FECHA2" class="java.lang.String"/>
	<parameter name="PR_INT_EMPRESA" class="java.lang.Integer"/>
	<parameter name="PR_STR_CONDICIONES" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
ghom.ghom_ideregistr,
MAX(ter.ter_nomcompleto) AS ter_nomcompleto,
MAX(dsus.dsus_pcodigo) AS dsus_pcodigo,
MAX(pro.pro_direccion) AS pro_direccion,
MAX(ba.barrio_nom) AS barrio_nom,
MAX(proy.proyecto_nom) AS proyecto_nom,
MAX(per.per_nombre) AS per_nombre,
MAX(ghom.emp_ideregistro) as empresaHomologaIde,
MAX(emp.empresa_nom) as empresaHomologaNom,
(
SELECT
empTmp.empresa_nom
FROM aseo.dgho_detallegestionhomologa detalle
INNER JOIN empresas empTmp ON empTmp.empresa_sevemp=detalle.emp_ideregistro
WHERE detalle.emp_ideregistro!= $P{PR_INT_EMPRESA} 
AND detalle.ghom_ideregistr=ghom.ghom_ideregistr
ORDER BY detalle.emp_ideregistro DESC
limit 1
) as empresaDetalle,
MAX(usu.usu_login) as usuario,
dgho.usu_ideregistro AS usuario,
(
SELECT
pfi.pfi_nombre
FROM opc_opcion opc inner join oppf_opcperfil oppf on opc.opc_ideregistro=oppf.opc_ideregistro
INNER JOIN  pfi_perfil pfi on pfi.pfi_ideregistro=oppf.pfi_ideregistro
INNER JOIN usem_usuempresa usem on usem.pfi_ideregistro=pfi.pfi_ideregistro
INNER JOIN prg_programa prg on opc.prg_ideregistro=prg.prg_ideregistro
WHERE  usem.usu_ideregistro=dgho.usu_ideregistro AND  usem.emp_ideregistro= $P{PR_INT_EMPRESA} 
LIMIT 1
) as perfil,
ghom.ghom_fecharegistro,
CASE EXTRACT (MONTH FROM ghom_fecharegistro)
WHEN 1 THEN 'ENERO'  WHEN 2 THEN 'FEBRERO' WHEN 3 THEN 'MARZO' WHEN 4 THEN 'ABRIL' WHEN 5 THEN 'MAYO'
WHEN 6 THEN 'JUNIO' WHEN 7 THEN 'JULIO' WHEN 8 THEN 'AGOSTO' WHEN 9 THEN 'SEPTIEMBRE' WHEN 10 THEN 'OCTUBRE'
WHEN 11 THEN 'NOVIEMBRE' WHEN 12 THEN 'DICIEMBRE'
END AS mes
FROM aseo.ghom_gestionhomologa ghom
INNER JOIN aseo.dgho_detallegestionhomologa dgho ON dgho.ghom_ideregistr=ghom.ghom_ideregistr
INNER JOIN dsus_detsuscrip dsus ON dsus.dsus_ideregistr=dgho.dsus_ideregistr
INNER JOIN ter_tercero ter ON ter.ter_ideregistro=dsus.ter_ideregistro
INNER JOIN pro_propiedad pro ON pro.pro_ideregistro=dsus.pro_ideregistro
INNER JOIN barrios ba ON ba.barrio_ideregistro=dsus.uni_barrio
INNER JOIN proyectos proy ON proy.proyecto_ideregistro=dsus.uni_municipio
INNER JOIN per_periodo per ON per.per_ideregistro=ghom.per_ideregistro
INNER JOIN empresas emp ON emp.empresa_sevemp=ghom.emp_ideregistro
INNER JOIN cic_ciclo cic ON cic.cic_ideregistro=dsus.cic_ideregistro
INNER JOIN usuarios usu ON usu.usu_ideregistro=dgho.usu_ideregistro
WHERE ghom.ghom_fecharegistro BETWEEN   $P{PR_STR_FECHA1}::DATE AND  $P{PR_STR_FECHA2}::DATE
 $P!{PR_STR_CONDICIONES} 
GROUP BY ghom.ghom_ideregistr,dgho.usu_ideregistro]]>
	</queryString>
