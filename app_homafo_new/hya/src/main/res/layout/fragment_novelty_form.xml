<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/novelty_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin"
                android:layout_marginBottom="@dimen/margin">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/title"
                    android:textColor="@color/title"
                    android:layout_marginTop="@dimen/margin"
                    android:layout_marginBottom="@dimen/margin"
                    android:text="@string/new_novelty"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/id_subscription"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/subscription_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:enabled="false"
                        android:focusableInTouchMode="false"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/date_novelty"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:clickable="false"
                        android:focusable="false"
                        android:enabled="false"
                        android:drawableEnd="@drawable/ic_calendar"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/pqr_novelty"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pqr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/novelty_visit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/selected_novelty_visit"
                    style="@style/DropDownLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <AutoCompleteTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        style="@style/InputTextFont"
                        tools:ignore="LabelFor" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/novelty_invoice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/selected_novelty_invoice"
                    style="@style/DropDownLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <AutoCompleteTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        style="@style/InputTextFont"
                        tools:ignore="LabelFor" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/novelty_request_type"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/request_type_novelty"
                    style="@style/DropDownLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <AutoCompleteTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        style="@style/InputTextFont"
                        tools:ignore="LabelFor" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/label"
                    android:textColor="@color/title"
                    android:text="@string/selected_novelty"
                    android:layout_marginBottom="@dimen/margin"/>

                <LinearLayout
                    android:id="@+id/result_type_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/margin">

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/multiline_text_novelty"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_photo_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_button_size"
                    android:text="@string/photographic_record"
                    style="@style/ButtonStyleTwo"
                    android:layout_marginBottom="@dimen/button_margin_bottom"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_button_size"
                    android:text="@string/save"
                    style="@style/ButtonStyle"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>