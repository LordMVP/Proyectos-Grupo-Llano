<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.homologationupdate.detail.MapDetailDialogFragment">

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content">

       <ScrollView
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           app:layout_constraintTop_toTopOf="parent">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:padding="@dimen/card_padding">

               <TextView
                   android:layout_width="match_parent"
                   android:text="Detalle del Mapa"
                   android:layout_height="wrap_content"
                   android:fontFamily="@font/poppins_medium"
                   android:textSize="@dimen/title"
                   android:textColor="@color/title"
                   android:layout_marginBottom="@dimen/card_space"/>

               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:text="@string/map_name"
                   android:fontFamily="@font/poppins_medium"
                   android:textSize="@dimen/card_subtitle"
                   android:textColor="@color/caption"/>

               <TextView
                   android:id="@+id/map_name"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:fontFamily="@font/poppins_medium"
                   android:textSize="@dimen/card_title"
                   android:textColor="@color/title"
                   android:layout_marginBottom="@dimen/card_space"/>

               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:text="@string/creation_date"
                   android:fontFamily="@font/poppins_medium"
                   android:textSize="@dimen/card_subtitle"
                   android:textColor="@color/caption"/>

               <TextView
                   android:id="@+id/creation_date"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:fontFamily="@font/poppins_medium"
                   android:textSize="@dimen/card_title"
                   android:textColor="@color/title"
                   android:layout_marginBottom="@dimen/card_space"/>


           </LinearLayout>

       </ScrollView>
   </androidx.constraintlayout.widget.ConstraintLayout>

</layout>