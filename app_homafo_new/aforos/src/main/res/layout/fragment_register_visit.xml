<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/input_margin_bottom">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/register_capacity_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/input_margin_bottom"
                android:padding="@dimen/margin"
                android:fitsSystemWindows="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/title"
                    android:textSize="@dimen/visit_title" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/visit_number"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/visit_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:enabled="false"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/watchword"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/watchword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/neighborhood"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/neighborhood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/address"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/user_code"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/user_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/visit_week"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/visit_week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/visit_type"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/visit_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_size"
                    android:hint="@string/file_number"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_marginBottom="@dimen/input_margin_bottom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/case_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        style="@style/InputTextFont"/>

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/input_margin_bottom"
                    android:fitsSystemWindows="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/visit_concepts"
                        android:textAlignment="center"
                        android:textColor="@color/title"
                        android:textSize="@dimen/label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_concept_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_button_size"
                        android:text="@string/add_concepts"
                        style="@style/ButtonStyle"
                        android:layout_marginBottom="@dimen/input_margin_bottom"/>

                    <TableLayout
                        android:id="@+id/concept_table"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/input_margin_bottom">

                    </TableLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/total_visit_volume"
                        android:textAlignment="center"
                        android:textColor="@color/title"
                        android:layout_marginBottom="@dimen/input_margin_bottom"
                        android:textSize="@dimen/input_text_size" />

                    <TextView
                        android:id="@+id/total_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="@dimen/input_margin_bottom"
                        android:textAlignment="center"
                        android:textColor="@color/title"
                        android:layout_marginBottom="@dimen/input_margin_bottom"
                        android:textSize="@dimen/input_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/total_visit_weight"
                        android:textAlignment="center"
                        android:textColor="@color/title"
                        android:layout_marginBottom="@dimen/input_margin_bottom"
                        android:textSize="@dimen/input_text_size" />

                    <TextView
                        android:id="@+id/total_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginStart="@dimen/input_margin_bottom"
                        android:textAlignment="center"
                        android:textColor="@color/title"
                        android:layout_marginBottom="@dimen/input_margin_bottom"
                        android:textSize="@dimen/input_text_size" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/input_margin_bottom"
                    android:hint="@string/observations_visit">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/note"
                        style="@style/InputTextFont"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_photo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_button_size"
                    android:text="@string/photographic_record"
                    style="@style/ButtonStyleTwo"
                    android:layout_marginBottom="@dimen/button_margin_bottom"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_button_size"
                    android:text="@string/confirm_button"
                    android:layout_marginBottom="@dimen/input_margin_bottom"
                    style="@style/ButtonStyle" />

            </LinearLayout>

        </ScrollView>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:textAlignment="center"
            android:textColor="@color/title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
