<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical"
            android:padding="@dimen/margin_cancel_visit">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/cancel_visit"
                android:textColor="@color/title"
                android:textSize="@dimen/title" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_cancel_note"
                android:layout_marginBottom="@dimen/input_margin_bottom"
                android:hint="@string/cancel_note"
                style="@style/EditTextInputLayoutStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/note"
                    style="@style/InputTextFont"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="textMultiLine" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_photo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_button_size"
                android:text="@string/photographic_record"
                style="@style/ButtonStyleTwo"
                android:layout_marginBottom="@dimen/button_margin_bottom"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_button_size"
                android:text="@string/cancel_visit"
                android:layout_marginBottom="@dimen/input_margin_bottom"
                style="@style/ButtonStyle" />



        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>