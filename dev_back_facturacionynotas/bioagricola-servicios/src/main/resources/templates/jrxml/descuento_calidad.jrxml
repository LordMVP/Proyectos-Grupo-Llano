<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cons_fact_aprov_iat" pageWidth="2300" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="890" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="b89063c8-709b-4bc5-982f-57d93dc67315">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapterTecnicoIntegral.xml"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="PR_STR_PERIODO_PRESTACION" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PR_INT_CONCEPTO" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select concat(pp.per_nombre,' ',extract(year from pp.per_fecinicial)) PERIODO , ds.dsus_pcodigo CODIGO,rp.trna TRNA,rp.tafna TAFNA, 
rr.rut_codigo MACRORUTA,rr.rut_nombre MICRORUTA,dd.valor_toneladas TONELADAS, dd.factor_desc VALOR,  dd.valor_toneladas  * dd.factor_desc DESCUENTO,
rr.rut_codigo NUMICRO,case when (fc.estrato < 7) then 'RESIDENCIAL' when(fc.estrato = 8) then 'PEQ GENERADOR' else 'GRAN GENERADOR' end USO,
fc.estrato CLASE,fc.aforado AFORO
from aseo.deca_desccalidad dd
inner join public.per_periodo pp on pp.per_ideregistro = dd.per_ideregistro_tarifas 
inner join public.dsus_detsuscrip ds on ds.dsus_ideregistr = dd.dsus_ideregistr
inner join public.rut_ruta rr on rr.rut_ideregistro = dd.rut_ideregistro 
inner join etl_aseo.rtsid_restonsemindcal_pro rp on rp.dsus_ideregistr = dd.dsus_ideregistr
inner join lateral (select * from public.fac_factura ff 
	where ff.dsus_ideregistr = dd.dsus_ideregistr and ff.uni_documento = 24 and ff.emp_ideregistro = 317 and 
		ff.fac_estado in ('A','F') and ff.fac_fecha between pp.per_fecinicial::timestamp + interval '1 month' 
		and pp.per_fecfinal::timestamp + interval '1 month' order by ff.fac_fecha desc limit 1) fac on true
inner join reportes.facturacion_consolidado_23 fc on fc.fac_ideregistro = fac.fac_ideregistro
where dd.uni_concepto_tarifas = $P{PR_INT_CONCEPTO} and dd.per_ideregistro_tarifas =  8360 and dd.desc_aplicado = false]]>
	</queryString>
