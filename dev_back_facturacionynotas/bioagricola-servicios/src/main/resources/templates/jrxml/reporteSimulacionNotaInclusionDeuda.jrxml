	<field name="CATASTRAL" class="java.lang.String"/>
	<field name="VALOR_EMITIDO" class="java.lang.Long"/>
	<field name="VALOR_AJUSTAR" class="java.lang.Long"/>
	<field name="NUEVO_SALDO" class="java.lang.Long"/>
